# The build context only carries what the Dockerfile COPYs:
# pyproject.toml, uv.lock, README.md, src/. Everything else inflates the
# upload and invalidates the cache for nothing.
.git
.github
.venv
.pytest_cache
.ruff_cache
.mypy_cache
__pycache__
*.pyc
tests/
docs/
contracts/
scripts/
Makefile
docker-compose.yml
Dockerfile
.dockerignore
.gitignore
